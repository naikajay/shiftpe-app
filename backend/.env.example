PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/shiftpe?retryWrites=true&w=majority
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
DB_SYNC_INDEXES=false
JWT_SECRET=replace_with_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=
RATE_LIMIT_MAX=300
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
ADMIN_SIGNUP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLATFORM_FEE_PERCENT=10
